{
  "name": "oheneba-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize-images": "node scripts/optimize-images.cjs",
    "build": "vite build",
    "critical": "critical dist/index.html --base=dist --inline --minify --extract --width=1300 --height=900",
    "audit:accessibility": "pa11y http://localhost:4173",
    "analyze": "vite build --sourcemap && npx source-map-explorer 'dist/assets/*.js'",
    "analyze:visual": "vite build --sourcemap --mode production && node scripts/generate-visualizer.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "critical": "^7.2.1",
    "source-map-explorer": "^2.5.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pa11y": "^9.1.1",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.1"
  }
}
